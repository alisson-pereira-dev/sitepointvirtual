# Itens do content.json com `validar: true` só aparecem quando esta flag é "1".
# Quando aparecem, ganham uma marca visível ("A validar"). Em produção, deixe vazio/ausente.
NEXT_PUBLIC_EXIBIR_ITENS_VALIDAR=1

# Só para depuração: com "1" cada evento de analytics é escrito em console.debug (não envia nada). Nunca em produção.
# NEXT_PUBLIC_DEBUG_EVENTOS=1
